# ═══════════════════════════════════════════════════════════════════════════════
# ระบบจัดการหอพัก Environment Configuration
# Copy this to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════════════

# ── DATABASE ──
# For development: file:./dev.db (SQLite local file)
# For Docker: file:/app/data/app.db (uses volume mount)
# For other SQLite: file:/path/to/database.db
DATABASE_URL="file:./dev.db"

# ── SESSION & AUTHENTICATION ──
# Used by iron-session to encrypt session cookies (product-owned local session)
# MUST be at least 32 characters long and random
# Generate a strong value: openssl rand -hex 32
# MUST NOT reuse Daiyooo Account's BETTER_AUTH_SECRET.
# Required in Docker/production; do not use a shared default value.
SESSION_PASSWORD="replace-with-random-value-from-openssl-rand-hex-32"

# ── DAIYOOO ACCOUNT OIDC (relying party / public client) ──
# ระบบจัดการหอพักเป็น OIDC client ตัวหนึ่งของ account.daiyooo.com (Better Auth).
# ค่า issuer ต้องตรง byte-for-byte กับ discovery metadata.
# Public client: ไม่มี client_secret (token_endpoint_auth_method=none, PKCE S256 required).
DAIYOOO_OIDC_ISSUER="https://account.daiyooo.com/api/auth"
DAIYOOO_OIDC_DISCOVERY_URL="https://account.daiyooo.com/.well-known/openid-configuration"
DAIYOOO_OIDC_CLIENT_ID="apartments"
# redirect_uri ต้องตรง exact กับที่ลงทะเบียนฝั่ง Daiyooo Account (no wildcard/fragment)
DAIYOOO_OIDC_REDIRECT_URI="https://apartments.daiyooo.com/auth/callback"
DAIYOOO_OIDC_SCOPES="openid profile email"
# OIDC prompt parameter. Keep select_account enabled so users can change Google account after logout.
# Allowed values: none, login, consent, select_account (space-separated)
# Optional OIDC prompt parameter. Leave empty by default.
# Better Auth (Daiyooo Account provider) rejects "select_account".
# Allowed: none, login, consent (space-separated, or empty for none).
DAIYOOO_OIDC_PROMPT=""
# Base URL ของ product (ใช้ validate return_to / ประกอบ redirect ตอน dev)
PRODUCT_BASE_URL="https://apartments.daiyooo.com"

# ── SMTP Configuration (Optional) ──
# If SMTP is not configured, the system will log PIN/passwords to console instead.
# Set these to enable email notifications for tenant PINs.

# SMTP server hostname (e.g., smtp.gmail.com, mail.example.com)
# SMTP_HOST=smtp.example.com

# SMTP server port (typically 587 for TLS, 465 for SSL)
# SMTP_PORT=587

# SMTP authentication username (usually your email address)
# SMTP_USER=your-email@example.com

# SMTP authentication password (use app-specific password for Gmail)
# SMTP_PASS=your-email-password

# From address for emails sent by the system
# SMTP_FROM="ระบบจัดการหอพัก <noreply@example.com>"

# ── PDF Generation ──
# Thai font path for bill PDF generation
# Default: uses bundled Sarabun font at assets/fonts/Sarabun-Regular.ttf
# Override if you need a different font file
# THAI_FONT_PATH=/path/to/custom-thai-font.ttf

# ── Server Configuration ──
# Hostname the server listens on (default: 0.0.0.0 for all interfaces)
# HOSTNAME=0.0.0.0

# Port the server listens on (default: 3000)
# PORT=3000
