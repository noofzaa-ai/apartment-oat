# ═══════════════════════════════════════════════════════════════════════════════
# ApartmentOAT Environment Configuration
# Copy this to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════════════

# ── DATABASE ──
# For development: file:./dev.db (SQLite local file)
# For Docker: file:/app/data/app.db (uses volume mount)
# For other SQLite: file:/path/to/database.db
DATABASE_URL="file:./dev.db"

# ── SESSION & AUTHENTICATION ──
# Used by iron-session to encrypt session cookies
# MUST be at least 32 characters long and random
# Generate a strong value: openssl rand -hex 32
# Default (DEV ONLY): change-me-to-at-least-32-character-random-string
SESSION_PASSWORD="change-me-to-at-least-32-character-random-string"

# ── SMTP Configuration (Optional) ──
# If SMTP is not configured, the system will log PIN/passwords to console instead.
# Set these to enable email notifications for tenant PINs.

# SMTP server hostname (e.g., smtp.gmail.com, mail.example.com)
# SMTP_HOST=smtp.example.com

# SMTP server port (typically 587 for TLS, 465 for SSL)
# SMTP_PORT=587

# SMTP authentication username (usually your email address)
# SMTP_USER=your-email@example.com

# SMTP authentication password (use app-specific password for Gmail)
# SMTP_PASS=your-email-password

# From address for emails sent by the system
# SMTP_FROM="ApartmentOAT <noreply@example.com>"

# ── PDF Generation ──
# Thai font path for bill PDF generation
# Default: uses bundled Sarabun font at assets/fonts/Sarabun-Regular.ttf
# Override if you need a different font file
# THAI_FONT_PATH=/path/to/custom-thai-font.ttf

# ── Server Configuration ──
# Hostname the server listens on (default: 0.0.0.0 for all interfaces)
# HOSTNAME=0.0.0.0

# Port the server listens on (default: 3000)
# PORT=3000
